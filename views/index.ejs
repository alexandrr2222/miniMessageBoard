<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <ul>
<% messages.forEach(msg => { %>
        <li>
            <div>
                <p> <%= msg.user %> </p>
                <time datetime=""> <%= msg.added %></time>
            </div>
            <p> <%= msg.text %></p>
        </li>
        <% });%>
    </ul>
  </body>
</html>
